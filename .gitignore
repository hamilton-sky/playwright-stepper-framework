__pycache__/
*.pyc
*.pyo
*.egg-info/
# Build artifacts — `pip install -e .` and `pip wheel` produce these now that
# the engine packages are actually packaged.
build/
dist/
.env
.env.local
.pytest_cache/

# Runtime outputs — keep the folders, ignore the contents
artifacts/*
!artifacts/.gitkeep
artifacts/screenshots/*
!artifacts/screenshots/.gitkeep

logs/*
!logs/.gitkeep

allure-results/*
!allure-results/.gitkeep

stepper/sites/openlibrary/artifacts/*
openlibrary/allure-results/*

# Runtime artifacts for every other site. Each run now writes screenshots and
# drift/session state into its own site directory rather than OpenLibrary's, so
# these have to be ignored per site. Committed fixtures (heal_cache.json,
# perf_smoke.json) are deliberately not matched.
stepper/sites/*/artifacts/screenshots/
stepper/sites/*/artifacts/drift_log.json
stepper/sites/*/artifacts/heal_suggestions.json
stepper/sites/shared/

# The db domain's default SQLite file. Unlike the per-run artifacts above it
# accumulates rather than being rewritten, so a committed copy would make every
# later run start from whatever state the last committer left behind. Point
# STEPPER_DB_PATH elsewhere to keep one deliberately.
stepper/sites/db/artifacts/

jira-to-stepper-pipeline/
plans/
strategy/


reports/*
!reports/.gitkeep

# Runtime report written to stepper/ root after each run
stepper/report.json

# Site-specific artifacts and reports (generated at runtime)
poms/artifacts/

# Engine-level artifacts. Visual baselines are the reference a comparison is
# judged against, so they belong in git; the amplified diff image written on a
# failure, screenshots and perf output are transient.
stepper/artifacts/baselines/*.diff.png
stepper/artifacts/screenshots/
stepper/artifacts/performance.json
stepper/reports/

storage_state.json

# ML model weights. `python stepper/download_models.py` fetches these, and both
# loaders fall back to the hub id when the directory is absent, so nothing here
# is needed to run — it is a cache.
#
# An 87MB all-MiniLM-L6-v2/model.safetensors was committed once. It made a
# clone of this repo 85MB of git history for a file pip can fetch, and it is
# still in the history of every commit up to the one that removed it; see
# scripts/purge-model-history.sh.
stepper/models/
